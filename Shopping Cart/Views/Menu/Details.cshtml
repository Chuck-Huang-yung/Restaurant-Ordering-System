@model ShoppingCart.Models.Menu

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <h2 class="text-center fw-bold mb-4">@Model.Name</h2>

    <div class="row">
        <div class="col-md-6">
            <img src="@Model.Img" class="img-fluid rounded" alt="@Model.Name" style="height: 350px; object-fit: cover;" />
        </div>
        <div class="col-md-6">
            <h4 class="fw-bold mb-2">金額：$@Model.Price</h4>
            <p class="fw-bold mb-2">特色：@Model.Description</p>
            <p class="fw-bold">辣度：@(Model.Spicy ? "🌶️辣" : "不辣")</p>

            <hr />

            <form id="addToCartForm">
                <input type="hidden" name="name" value="@Model.Name" />
                <h5 class="fw-bold mb-2">🍹 加購選項：</h5>
                <div class="form-check mb-2">
                    <input class="form-check-input addon-checkbox" type="checkbox" value="西米露:60" id="addon1" name="addons" />
                    <label class="form-check-label fw-bold" for="addon1">西米露 (+$60)</label>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input addon-checkbox" type="checkbox" value="泰奶:70" id="addon2" name="addons" />
                    <label class="form-check-label fw-bold" for="addon2">泰奶 (+$70)</label>
                </div>

                <h6 class="fw-bold">選擇份數：</h6>
                <div class="input-group mb-3 w-50">
                    <button type="button" class="btn btn-outline-secondary" onclick="updateQty(-1)">-</button>
                    <input type="text" class="form-control text-center" id="qty" name="quantity" value="1" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="updateQty(1)">+</button>
                </div>

                <h5 class="fw-bold">總金額：$<span id="totalPrice">@Model.Price</span></h5>


                <div class="mb-3">
                    <label for="remark" class="form-label fw-bold">備註</label>
                    <input type="text" class="form-control" id="remark" name="remark" placeholder="請輸入備註（選填）" />
                </div>

                <button type="submit" class="btn btn-primary fw-bold mt-3">加入購物車</button>
            </form>

            <!-- 顯示加入成功通知 -->
            <div id="notification" class="mt-3 text-success fw-bold"></div>
        </div>
    </div>

    
    <!-- 購物車統計區塊 -->
    <div id="cartSummary" class="mt-5 p-3 bg-light border rounded fw-bold d-flex justify-content-between align-items-center">
        <div id="cartText">
            購物車：@ViewBag.CartQuantity 件商品，總金額 NT$ @ViewBag.CartAmount
        </div>
        <a href="/Menu/Cart" class="btn btn-sm btn-outline-primary">前往購物車</a>
    </div>




</div>

@section Scripts {
    <script>
        //商品數量控制、加價選項計算、即時計算總金額，以及加入購物車並即時更新購物車摘要區塊
        let basePrice = parseFloat("@Model.Price");


        function updateQty(change) {
            let qtyInput = document.getElementById("qty");
            let qty = parseInt(qtyInput.value);
            qty = Math.max(1, qty + change);
            qtyInput.value = qty;
            calculateTotal();
        }

        function calculateTotal() {
            let qty = parseInt(document.getElementById("qty").value);
            let addons = document.querySelectorAll(".addon-checkbox:checked");
            let addonTotal = 0;
            addons.forEach(a => {
                let value = a.value;
                let parts = value.split(":");
                if (parts.length === 2) {
                    addonTotal += parseInt(parts[1]);
                }
            });
            let total = (basePrice + addonTotal) * qty;
            document.getElementById("totalPrice").innerText = total;
        }

        document.querySelectorAll(".addon-checkbox").forEach(cb => {
            cb.addEventListener("change", calculateTotal);
        });

        calculateTotal();

        document.getElementById("addToCartForm").addEventListener("submit", function (e) {
            e.preventDefault();

            let form = e.target;
            let formData = new FormData(form);

            fetch('/Menu/AddToCart', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const notification = document.getElementById("notification");
                        notification.innerText = data.message;

                        const cartSummary = document.getElementById("cartSummary");
                              cartSummary.innerHTML = `
                              <div id="cartText">
                              購物車：${data.totalQuantity} 件商品，總金額 NT$ ${data.totalAmount}
                              </div>
                             <a href="/Menu/Cart" class="btn btn-sm btn-outline-primary">前往購物車</a> `;


                    }
                    else {
                        alert("加入購物車失敗：" + data.message);
                    }
                })
                .catch(() => {
                    alert("伺服器錯誤，請稍後再試");
                });
        });
    </script>
}
